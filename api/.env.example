# Hàng Chọn API — sao chép thành api/.env. Để trống các khoá vẫn chạy được với AI giả + tích hợp giả.
# KHÔNG commit api/.env (đã có trong .gitignore).

# ---- ứng dụng ----
APP_ENV=dev
WEB_BASE_URL=http://localhost:3010
API_BASE_URL=http://localhost:8010
CORS_ORIGINS=["http://localhost:3010"]
LOG_LEVEL=INFO

# ---- dữ liệu (docker compose: Postgres 5442, Redis 6382) ----
DATABASE_URL=postgresql+asyncpg://hangchon:hangchon@localhost:5442/hangchon
DATABASE_ECHO=false
REDIS_URL=redis://localhost:6382/0
# Test dùng CSDL riêng theo tên thư mục worktree: hangchon_test_<thu_muc>; đổi máy chủ bằng TEST_PG_URL
# TEST_PG_URL=postgresql+asyncpg://hangchon:hangchon@localhost:5442

# ---- đăng nhập ----
JWT_SECRET=doi-chuoi-nay-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
JWT_EXPIRE_MINUTES=20160
COOKIE_NAME=hc_session
COOKIE_SECURE=false
COOKIE_DOMAIN=
# Tài khoản chị: tạo khi API khởi động (nếu chưa có) và khi chạy `uv run python -m app.seed`
OWNER_EMAIL=chi@hangchon.local
OWNER_PASSWORD=doimatkhau
OWNER_NAME=Chị
CREATE_OWNER_ON_STARTUP=true

# ---- mã hoá bí mật lưu trong CSDL (khoá API chị nhập ở Cài đặt → AI và khoá API) ----
# Khoá Fernet riêng (KHÔNG dùng lại JWT_SECRET). Để trống ở dev/test = khoá dev cố định (có cảnh báo); production bắt buộc.
# Sinh: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Xoay khoá: "khoa_moi,khoa_cu" (khoá đầu để mã hoá, mọi khoá đều thử khi giải mã). Mất khoá = phải nhập lại khoá API.
SECRETS_ENCRYPTION_KEY=

# ---- AI ----
# Chị đổi được provider/khoá/model/effort/trần ở Cài đặt → «AI và khoá API» (lưu trong CSDL, ghi đè các biến dưới đây).
# Chép cấu hình dưới đây vào CSDL một lần: cd api && uv run python -m app.ai.import_env_config
# fake = hàm giả (không cần khoá) · anthropic = Claude API · openrouter = OpenRouter (API tương thích OpenAI)
AI_PROVIDER=fake
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model của provider ở AI_PROVIDER (OpenRouter dùng tên dạng hãng/model)
AI_MODEL_SMART=claude-opus-5-5
AI_MODEL_FAST=claude-haiku-5-5
AI_EFFORT_SMART=medium
AI_EFFORT_FAST=low
AI_MAX_TOKENS=16000
AI_TIMEOUT_SECONDS=300
AI_MAX_RETRIES=2
# "default" = bật server-side fallbacks khi model từ chối (chỉ cho model trong AI_FALLBACK_MODELS); để trống = tắt
AI_FALLBACKS=default
AI_FALLBACK_MODELS=["claude-opus-5-5","claude-opus-5"]
# Trần chi phí AI mỗi tháng (k2). Chị đổi được trên giao diện (ghi đè bằng app_settings). 0 = không giới hạn.
AI_MONTHLY_BUDGET_VND=1500000
AI_USD_VND_RATE=26000
AI_WEB_SEARCH_USD_PER_1K=10
# Bảng giá ghi đè (USD / 1 triệu token), JSON: {"claude-opus-5-5": {"input": 4, "output": 20, "cache_read": 0.2, "cache_write": 5}}
AI_PRICING=

# ---- việc nền ----
JOBS_EAGER=false
# hàng đợi arq trên Redis; scripts/dev.sh tự đặt arq:hangchon:<thư mục> cho từng bản làm việc
# JOBS_QUEUE_NAME=arq:queue

# ---- lưu trữ tệp: local | s3 ----
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_PUBLIC_BASE_URL=http://localhost:8010/api/files
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# ---- tích hợp ngoài: driver mặc định mock ----
SOURCES_DRIVER=mock          # mock | web | onebound
SOCIAL_DRIVER=mock           # mock | meta | tiktok_draft | zalo_oa
# driver theo kênh, dùng chung cho đăng bài và hộp thư; kênh không khai dùng SOCIAL_DRIVER
# vd: facebook=meta,instagram=meta,threads=meta,zalo_oa=zalo_oa,tiktok=tiktok_draft
SOCIAL_CHANNEL_DRIVERS=
PAYMENTS_DRIVER=mock         # mock | sepay
SHIPPING_DRIVER=mock         # mock | ghn | ghtk
NOTIFY_DRIVER=mock           # mock | zalo_zns | email
# driver báo tin theo kênh; kênh không khai dùng NOTIFY_DRIVER. vd: zalo_oa=zalo_zns,email=email
NOTIFY_CHANNEL_DRIVERS=
MARKETPLACES_DRIVER=mock     # mock | tiktok_shop | shopee
EINVOICE_DRIVER=mock

# nguồn hàng
ONEBOUND_API_KEY=
ONEBOUND_API_SECRET=
# Meta (Facebook Page, Instagram, Threads)
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_TOKEN=
META_IG_USER_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v24.0
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
# TikTok (đẩy bản nháp)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
# Zalo OA
ZALO_OA_ID=
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_SECRET=
ZALO_APP_ID=
ZALO_OA_AUTHOR=Hàng Chọn
# true = bài viết OA gửi luôn tới người quan tâm (tốn hạn mức tin của gói OA)
ZALO_OA_BROADCAST=false
# Zalo ZNS (báo tin khách, driver zalo_zns). Access token OA hết hạn sau 25 giờ: đặt refresh token + khoá bí mật
# của ỨNG DỤNG (khác ZALO_OA_SECRET) để tự làm mới; refresh token dùng một lần nên token mới lưu ở ZALO_TOKEN_FILE
# (để trống = chỉ giữ trong bộ nhớ, đủ cho máy dev).
ZALO_APP_SECRET=
ZALO_OA_REFRESH_TOKEN=
ZALO_TOKEN_FILE=
# loại tin → mẫu ZNS đã duyệt; params: tên tham số trong mẫu Zalo → ô dữ liệu (ten, ma_don, tong_tien, link...)
# vd: {"order_received": {"template_id": "123456", "params": {"customer_name": "ten", "order_code": "ma_don"}}}
ZALO_ZNS_TEMPLATES=
# true = gửi mode=development (chỉ tới quản trị viên OA/ứng dụng) để thử mẫu
ZALO_ZNS_DEVELOPMENT=false
# thanh toán VietQR / SePay
SEPAY_API_KEY=
SEPAY_WEBHOOK_SECRET=
BANK_CODE=MOCKBANK
BANK_ACCOUNT_NO=0000000000
BANK_ACCOUNT_NAME=HANG CHON
PAYMENT_CODE_PREFIX=HC
# vận chuyển
GHN_TOKEN=
GHN_SHOP_ID=
GHN_ENV=prod                 # prod | dev (máy thử của GHN)
GHTK_TOKEN=
GHTK_ENV=prod                # prod | dev
# địa chỉ lấy hàng GHTK (tỉnh lấy từ SHIPPING_FROM_PROVINCE)
GHTK_PICK_NAME=
GHTK_PICK_TEL=
GHTK_PICK_ADDRESS=
GHTK_PICK_DISTRICT=
GHTK_PICK_WARD=
SHIPPING_FROM_PROVINCE=Hà Nội
MOCK_SHIPPING_STEP_SECONDS=3600
# email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Hàng Chọn <no-reply@hangchon.local>
# starttls (cổng 587) | ssl (cổng 465) | none (chỉ máy chủ thử nội bộ)
SMTP_TLS=starttls
SMTP_TIMEOUT_SECONDS=20
# sàn
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=
SHOPEE_ACCESS_TOKEN=
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
TIKTOK_SHOP_ACCESS_TOKEN=
TIKTOK_SHOP_CIPHER=
# chữ ký webhook của các driver mock (/api/hooks/**); chỉ có tác dụng ở dev/test (prod luôn 404)
HOOKS_MOCK_SECRET=mock-webhook-secret

# ---- dựng video (f6) ----
CONTENT_FFMPEG=true          # false = chỉ xuất bản kế hoạch dựng, không gọi ffmpeg
CONTENT_FONT_PATH=           # phông phụ đề (để trống = tự tìm)

# ---- sao lưu (k4) ----
# pg_dump trên máy (để trống = tìm trong PATH); không có thì dùng `docker exec <container> pg_dump`
PG_DUMP_PATH=
PG_DUMP_DOCKER_CONTAINER=hangchon-postgres-1
